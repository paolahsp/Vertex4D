# Copy this file to .env locally. Never commit real secrets.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VERTEX4D_SESSION_SECRET=replace-with-at-least-32-random-characters
VERTEX4D_SECURE_COOKIES=false
VERTEX4D_MAX_UPLOAD_BYTES=10485760
VERTEX4D_DATABASE_PATH=vertex4d.db

OPENAI_API_KEY=replace-with-host-secret
ALEX_OPENAI_API_KEY=replace-with-host-secret
