# VERTEX 4D / Srsly Labs semi-private deployment example.
# Copy values into your host secret manager or local .env file.
# Never commit real secrets, real API keys, production databases, or runtime artifacts.

# Server / session
VERTEX4D_SESSION_SECRET=replace-with-a-long-random-secret
PORT=8001

# Persistent storage
VERTEX4D_DATABASE_PATH=/data/vertex4d.db
VERTEX4D_RUNTIME_DIR=/data/runs
VERTEX4D_BILLIE_SCENARIO_DIR=/data/billie/financial_scenarios

# Program role controls
VERTEX4D_FACILITATOR_EMAILS=facilitator@example.org
VERTEX4D_FACILITATOR_INVITE_CODE=replace-with-private-program-invite-code

# AI providers
OPENAI_API_KEY=replace-with-host-secret
ALEX_OPENAI_API_KEY=replace-with-host-secret
VERTEX4D_LLM_RUN_BUDGET=20
