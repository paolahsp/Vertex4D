{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertex4d.local/contracts/v1/project-record.schema.json",
  "title": "VERTEX 4D ProjectRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "created_at",
    "created_by_role",
    "status",
    "provenance",
    "human_approval",
    "validation_errors",
    "project_name",
    "venture_description",
    "challenge_statement",
    "venture_stage",
    "geography",
    "impact_area",
    "cohort_program_context",
    "synthetic_data_declaration",
    "current_artifact_references"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact_type": { "type": "string", "const": "project_record" },
    "artifact_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by_role": { "type": "string", "enum": ["founder", "facilitator", "admin", "system"] },
    "status": { "type": "string", "enum": ["draft", "pending_review", "approved", "rejected", "superseded"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_label", "ip_owner", "external_components_used", "notes"],
      "properties": {
        "source_kind": { "type": "string", "enum": ["synthetic_fixture", "user_supplied", "imported", "system_generated"] },
        "source_label": { "type": "string" },
        "ip_owner": { "type": "string" },
        "external_components_used": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "state", "approved_by_role", "approved_at", "notes"],
      "properties": {
        "required": { "type": "boolean" },
        "state": { "type": "string", "enum": ["not_required", "pending", "approved", "rejected"] },
        "approved_by_role": { "type": ["string", "null"], "enum": ["founder", "facilitator", "admin", null] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "validation_errors": { "type": "array", "items": { "type": "string" } },
    "project_name": { "type": "string" },
    "venture_description": { "type": "string" },
    "challenge_statement": { "type": "string" },
    "venture_stage": { "type": "string", "enum": ["idea", "discovery", "prototype", "pilot", "launched"] },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_city", "country", "operating_scope"],
      "properties": {
        "primary_city": { "type": "string" },
        "country": { "type": "string" },
        "operating_scope": { "type": "string", "enum": ["local", "regional", "national", "international"] }
      }
    },
    "impact_area": { "type": "array", "items": { "type": "string", "enum": ["climate", "circular_economy", "food_systems", "gender_equity", "education", "health", "financial_resilience", "other"] } },
    "cohort_program_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_name", "cohort_name", "facilitator_role", "notes"],
      "properties": {
        "program_name": { "type": "string" },
        "cohort_name": { "type": "string" },
        "facilitator_role": { "type": "string" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "synthetic_data_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_synthetic", "contains_identifiable_people", "approved_for_predictive_processing", "statement"],
      "properties": {
        "is_synthetic": { "type": "boolean", "const": true },
        "contains_identifiable_people": { "type": "boolean", "const": false },
        "approved_for_predictive_processing": { "type": "boolean" },
        "statement": { "type": "string" }
      }
    },
    "current_artifact_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_frame_id", "system_map_id", "predictive_hypothesis_id", "financial_scenario_id", "decision_record_id"],
      "properties": {
        "problem_frame_id": { "type": ["string", "null"] },
        "system_map_id": { "type": ["string", "null"] },
        "predictive_hypothesis_id": { "type": ["string", "null"] },
        "financial_scenario_id": { "type": ["string", "null"] },
        "decision_record_id": { "type": ["string", "null"] }
      }
    }
  }
}
