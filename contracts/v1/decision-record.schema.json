{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertex4d.local/contracts/v1/decision-record.schema.json",
  "title": "VERTEX 4D DecisionRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "created_at",
    "created_by_role",
    "status",
    "provenance",
    "human_approval",
    "validation_errors",
    "linked_upstream_artifact_ids",
    "decision_question",
    "alternatives_considered",
    "evidence_summary",
    "assumptions",
    "predictive_hypotheses",
    "financial_scenarios",
    "risks",
    "unknowns",
    "contradictions",
    "selected_decision",
    "rationale",
    "rejected_alternatives",
    "next_experiment",
    "success_criteria",
    "owner_role",
    "review_date",
    "facilitator_approval",
    "audit_trail"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact_type": { "type": "string", "const": "decision_record" },
    "artifact_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by_role": { "type": "string", "enum": ["founder", "facilitator", "system"] },
    "status": { "type": "string", "enum": ["draft", "pending_review", "approved", "rejected", "superseded"] },
    "provenance": { "type": "object" },
    "human_approval": { "type": "object" },
    "validation_errors": { "type": "array" },
    "linked_upstream_artifact_ids": { "type": "object" },
    "decision_question": { "type": "string" },
    "alternatives_considered": { "type": "array" },
    "evidence_summary": { "type": "array" },
    "assumptions": { "type": "array" },
    "predictive_hypotheses": { "type": "array" },
    "financial_scenarios": { "type": "array" },
    "risks": { "type": "array" },
    "unknowns": { "type": "array" },
    "contradictions": { "type": "array" },
    "selected_decision": { "type": "object" },
    "rationale": { "type": "string" },
    "rejected_alternatives": { "type": "array" },
    "next_experiment": { "type": "object" },
    "success_criteria": { "type": "array" },
    "owner_role": { "type": "string", "enum": ["founder", "facilitator", "admin"] },
    "review_date": { "type": "string", "format": "date" },
    "facilitator_approval": { "type": "object" },
    "audit_trail": { "type": "array" }
  }
}
