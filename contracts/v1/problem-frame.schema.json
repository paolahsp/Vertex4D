          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "classification": {
              "type": "string",
              "enum": [
                "fact",
                "inference",
                "hypothesis",
                "unknown",
                "predictive_hypothesis"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "contextual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "classification",
            "confidence",
            "evidence_refs"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "classification": {
              "type": "string",
              "enum": [
                "fact",
                "inference",
                "hypothesis",
                "unknown",
                "predictive_hypothesis"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "systemic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "classification",
            "confidence",
            "evidence_refs"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "classification": {
              "type": "string",
              "enum": [
                "fact",
                "inference",
                "hypothesis",
                "unknown",
                "predictive_hypothesis"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "problem_framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "classification",
            "confidence",
            "evidence_refs"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "classification": {
              "type": "string",
              "enum": [
                "fact",
                "inference",
                "hypothesis",
                "unknown",
                "predictive_hypothesis"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "approved_for_system_mapping",
        "approved_for_decision_record",
        "approved_for_financial_processing",
        "pending_founder_review",
        "pending_financial_review"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertex4d.local/contracts/v1/problem-frame.schema.json",
  "title": "VERTEX 4D problem_frame v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "human_approval": {
            "properties": {
              "state": {
                "const": "approved"
              },
              "approved_by_role": {
                "type": "string"
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ]
}
