{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "created_at",
    "created_by_role",
    "status",
    "provenance",
    "human_approval",
    "validation_errors",
    "preceding_artifacts",
    "original_challenge",
    "reframed_problem",
    "affected_users",
    "needs",
    "assumptions",
    "tensions",
    "evidence_references",
    "unknowns",
    "four_dimensions_analysis",
    "approval_state",
    "revision",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "problem_frame"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "created_by_role": {
      "type": "string",
      "enum": [
        "founder",
        "facilitator",
        "admin",
        "system",
        "alex",
        "synapmap",
        "d_predict",
        "finops"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_label",
        "ip_owner",
        "external_components_used",
        "notes"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "synthetic_fixture",
            "user_supplied",
            "imported",
            "system_generated"
          ]
        },
        "source_label": {
          "type": "string",
          "minLength": 1
        },
        "ip_owner": {
          "type": "string",
          "minLength": 1
        },
        "external_components_used": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state",
        "approved_by_role",
        "approved_at",
        "notes"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_by_role": {
          "type": "string",
          "enum": [
            "founder",
            "facilitator",
            "admin"
          ]
        },
        "approved_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "preceding_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_record_id"
      ],
      "properties": {
        "project_record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        }
      }
    },
    "original_challenge": {
      "type": "string",
      "minLength": 1
    },
    "reframed_problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "classification",
        "confidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "fact",
            "inference",
            "hypothesis",
            "unknown",
            "predictive_hypothesis"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "affected_users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_group_id",
          "label",
          "classification",
          "evidence_refs"
        ],
        "properties": {
          "user_group_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "hypothesis",
              "unknown",
              "predictive_hypothesis"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "classification",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "hypothesis",
              "unknown",
              "predictive_hypothesis"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "statement",
          "classification",
          "confidence",
          "approval_state",
          "approved_for_predictive_processing",
          "approved_for_financial_processing",
          "evidence_refs"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "hypothesis",
              "unknown",
              "predictive_hypothesis"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "approval_state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "approved_for_system_mapping",
              "approved_for_decision_record",
              "approved_for_financial_processing",
              "pending_founder_review",
              "pending_financial_review"
            ]
          },
          "approved_for_predictive_processing": {
            "type": "boolean"
          },
          "approved_for_financial_processing": {
            "type": "boolean"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "classification",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "hypothesis",
              "unknown",
              "predictive_hypothesis"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "label",
          "source_type",
          "classification",
          "contains_personal_data",
          "evidence_context"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "synthetic_interview_note",
              "synthetic_observation",
              "synthetic_market_note",
              "synthetic_financial_note"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "hypothesis",
              "unknown",
              "predictive_hypothesis"
            ]
          },
          "contains_personal_data": {
            "type": "boolean"
          },
          "evidence_context": {
            "type": "string",
            "const": "synthetic_fixture"
          }
        }
      },
      "minItems": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "classification",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "hypothesis",
              "unknown",
              "predictive_hypothesis"
            ]
          },
          "confidence": {
            "type": "integer"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "four_dimensions_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotional",
        "contextual",
        "systemic",
        "problem_framing"
      ],
      "properties": {
        "emotional": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "classification",
            "confidence",
            "evidence_refs"
