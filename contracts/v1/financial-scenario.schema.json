{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertex4d.local/contracts/v1/financial-scenario.schema.json",
  "title": "VERTEX 4D FinancialScenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "created_at",
    "created_by_role",
    "status",
    "provenance",
    "human_approval",
    "validation_errors",
    "preceding_artifacts",
    "approved_assumption_references",
    "currency",
    "scenario_name",
    "time_horizon",
    "pricing_assumptions",
    "cost_assumptions",
    "volume_assumptions",
    "revenue_projection",
    "cost_projection",
    "cash_requirement",
    "sustainability_indicators",
    "sensitivity_notes",
    "uncertainty",
    "approval_state"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact_type": { "type": "string", "const": "financial_scenario" },
    "artifact_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by_role": { "type": "string", "enum": ["finops", "system"] },
    "status": { "type": "string", "enum": ["draft", "pending_review", "approved", "rejected", "superseded"] },
    "provenance": { "type": "object" },
    "human_approval": { "type": "object" },
    "validation_errors": { "type": "array" },
    "preceding_artifacts": { "type": "object" },
    "approved_assumption_references": { "type": "array" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "scenario_name": { "type": "string" },
    "time_horizon": { "type": "string" },
    "pricing_assumptions": { "type": "array" },
    "cost_assumptions": { "type": "array" },
    "volume_assumptions": { "type": "array" },
    "revenue_projection": { "type": "object" },
    "cost_projection": { "type": "object" },
    "cash_requirement": { "type": "object" },
    "sustainability_indicators": { "type": "array" },
    "sensitivity_notes": { "type": "array" },
    "uncertainty": { "type": "object" },
    "approval_state": { "type": "string", "enum": ["pending_financial_review", "approved_for_decision_record", "rejected"] }
  }
}
